# Flask ve JWT
SECRET_KEY=
JWT_SECRET=
SITE_URL=https://wwwgumusvet.com
CORS_ORIGIN=https://wwwgumusvet.com

# İlk kurulumda admin hesabını oluşturmak için kullanılır.
# İlk başarılı kurulumdan sonra INITIAL_ADMIN_PASSWORD kaldırılabilir.
INITIAL_ADMIN_EMAIL=gumusveterinermuayenehanesi@gmail.com
INITIAL_ADMIN_PASSWORD=

# Render PostgreSQL hazırlığı
DATABASE_URL=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# SQLite kullanırken Render persistent disk mount path:
SQLITE_DB_PATH=/var/data/gumus_veteriner.db

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://wwwgumusvet.com/login/google/authorized

# Mail sağlayıcısı: Render Free için brevo kullanın.
MAIL_PROVIDER=brevo
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Gümüş Veteriner
BREVO_REPLY_TO=

# İsteğe bağlı SMTP fallback: Render Free planda 25, 465 ve 587 portları kapalıdır.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
# Yalnızca geçici SMTP testi için açın, testten sonra tekrar false yapın.
DEBUG_MAIL_TEST=false
SMTP_TEST_RECIPIENT=

# Netgsm SMS
SMS_PROVIDER=netgsm
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_HEADER=

# Rate limit için production ortamında Redis önerilir.
RATELIMIT_STORAGE_URI=memory://

# Upload üst sınırı: varsayılan 5 MB.
MAX_UPLOAD_BYTES=5242880
