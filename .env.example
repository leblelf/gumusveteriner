# Bu dosyada gerçek değer tutulmaz. Değerleri Render Environment alanına ekleyin.

# Flask ve JWT
SECRET_KEY=
JWT_SECRET=
SITE_URL=
CORS_ORIGIN=

# İlk kurulumda admin hesabını oluşturmak için kullanılır.
# İlk başarılı kurulumdan sonra INITIAL_ADMIN_PASSWORD kaldırılabilir.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Render PostgreSQL hazırlığı
DATABASE_URL=
DB_POOL_SIZE=
DB_MAX_OVERFLOW=

# SQLite kullanırken Render persistent disk mount path:
SQLITE_DB_PATH=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Render SMTP portlarını engellerse Gmail API üzerinden HTTPS gönderimi için.
GMAIL_REFRESH_TOKEN=

# Google App Password ile Gmail SMTP.
MAIL_PROVIDER=
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=
# Yalnızca geçici SMTP testi için açın, testten sonra tekrar false yapın.
DEBUG_MAIL_TEST=
SMTP_TEST_RECIPIENT=

# Netgsm SMS
SMS_PROVIDER=
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_HEADER=

# Rate limit için production ortamında Redis önerilir.
RATELIMIT_STORAGE_URI=

# Upload üst sınırı: varsayılan 5 MB.
MAX_UPLOAD_BYTES=
